-- Adds one new poster template: {{TITLE}}
-- Generated by scripts/templates/add-template.sh — edit placeholder
-- coordinates below to match where shop name / rates / logo should land
-- on this specific background image before running `mvn flyway:migrate`
-- or letting the app apply it on startup.

INSERT INTO templates (
    category_id, title, thumbnail_url, background_image_key,
    price, schema_json, is_festival, is_active, plan_tier_min
) VALUES (
    (SELECT id FROM categories WHERE slug = '{{CATEGORY_SLUG}}'),
    '{{TITLE}}',
    '{{THUMBNAIL_KEY}}',
    '{{BACKGROUND_KEY}}',
    {{PRICE}},
    '{
        "canvasWidth": {{CANVAS_WIDTH}},
        "canvasHeight": {{CANVAS_HEIGHT}},
        "placeholders": [
            { "type": "text", "field": "shopName", "x": 60, "y": {{CANVAS_HEIGHT_MINUS_170}}, "fontSize": 42, "fontFamily": "playfair", "color": "#F5D061", "align": "left" },
            { "type": "text", "field": "rate22k916", "x": 60, "y": {{CANVAS_HEIGHT_MINUS_115}}, "fontSize": 30, "fontFamily": "inter", "color": "#FFFFFF", "align": "left" },
            { "type": "text", "field": "rate18k", "x": 60, "y": {{CANVAS_HEIGHT_MINUS_80}}, "fontSize": 24, "fontFamily": "inter", "color": "#FFFFFF", "align": "left" },
            { "type": "image", "field": "shopLogo", "x": {{CANVAS_WIDTH_MINUS_180}}, "y": {{CANVAS_HEIGHT_MINUS_200}}, "width": 120, "height": 120 }
        ]
    }',
    false, true, '{{PLAN_TIER}}'
);
