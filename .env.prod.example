# Copy to .env.prod and fill in real values. NEVER commit .env.prod — only this
# .example file. Used by `docker compose -f docker-compose.prod.yml --env-file .env.prod up`,
# or copy these same keys into your PaaS's environment-variable settings
# (Railway/Render "Variables" tab) if you're not self-hosting.

# --- Spring profile ---
# REQUIRED. There is no default profile; without this the app fails to start.
SPRING_PROFILES_ACTIVE=prod

# --- Database ---
# Self-hosting via docker-compose.prod.yml: pick any values, compose wires them up.
# Managed Postgres (Supabase/RDS/Railway Postgres): use the credentials it gives you,
# and set DB_URL directly instead (jdbc:postgresql://<host>:<port>/<db>?sslmode=require).
DB_NAME=posterpro
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Auth ---
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# --- Storage (MinIO self-hosted, or any S3-compatible provider) ---
# S3 API endpoint the BACKEND uses to reach storage (internal MinIO URL, or e.g.
# https://<account>.r2.cloudflarestorage.com). Also the host presigned URLs are
# signed against. REQUIRED — application-prod.yml has no default for it.
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=CHANGE_ME
STORAGE_S3_SECRET_KEY=CHANGE_ME
STORAGE_S3_BUCKET=posterpro
# Public URL the mobile app / browser can reach — your domain in front of
# MinIO/S3 (e.g. https://storage.posterpro.app), NOT an internal hostname.
STORAGE_S3_PUBLIC_BASE_URL=CHANGE_ME

# --- Razorpay (LIVE keys — Dashboard > Settings > API Keys) ---
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Dashboard > Settings > Webhooks > add https://<your-api-domain>/api/payments/webhook/razorpay,
# subscribe to "payment.captured" and "order.paid", then paste the secret it shows you.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# --- Plan pricing (INR, monthly) — confirm these are the real prices before launch ---
PLAN_PRICE_BASIC=299
PLAN_PRICE_PREMIUM=599
PLAN_PRICE_ENTERPRISE=1499

# --- CORS ---
# Only matters if a browser-based client exists (Flutter web build, admin
# dashboard). Comma-separated origins, e.g. https://app.posterpro.com
CORS_ALLOWED_ORIGINS=*
